# ── Reddit (the bot's own "script" app + account) ────────────────────────────
# Create the app at https://www.reddit.com/prefs/apps  → type "script".
# The client ID is the short string under the app name; the secret is shown
# next to it. USERNAME/PASSWORD are the bot's Reddit account login.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# A descriptive, unique User-Agent is REQUIRED by Reddit's API rules.
# Format: platform:app-id:version (by /u/your-bot)
REDDIT_USER_AGENT=web:slop-research-importer:0.1.0 (by /u/your-bot)

# What to scrape. Defaults match the two "found in the wild" flairs.
SUBREDDIT=aislop
FLAIRS=Found in the wild,Found IRL

# ── The slop app (where submissions go) ──────────────────────────────────────
# The public base URL of the deployed app, e.g. https://slop.matybohacek.com
SLOP_API_URL=
# The bot's account INSIDE the app — register it normally at /register as a
# plain USER so its submissions land in the review queue (PENDING).
SLOP_BOT_EMAIL=
SLOP_BOT_PASSWORD=

# ── Anthropic (vision enrichment) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Geocoding (OpenStreetMap Nominatim, no key) ──────────────────────────────
# A contact (your email) sent to Nominatim per its usage policy.
NOMINATIM_CONTACT=

# ── Behavior ─────────────────────────────────────────────────────────────────
# DRY_RUN=true runs Reddit + enrichment + geocoding but does NOT submit to the
# app. Great for testing before the bot account exists. Default: false.
DRY_RUN=false
# Max posts to process in one run. Backfill uses this as the hard ceiling per
# flair; the weekly run rarely reaches it. Default 1000 (Reddit's listing cap).
MAX_POSTS=1000
