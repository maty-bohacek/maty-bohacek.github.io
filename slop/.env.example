# ──────────────────────────────────────────────────────────────────────────
#  AI Slop in the Wild — environment variables
#
#  Copy to `.env` for local dev. On Railway, set these in the service's
#  Variables tab. NEVER commit real secrets — this repo is public.
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway: add a Postgres plugin and reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user:password@localhost:5432/slop?schema=public"

# Secret used to sign session cookies (JWT, HS256).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# The single super-admin account. Logging in with these credentials grants
# full admin powers. The account is created/reconciled automatically on boot.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD="a-strong-password-you-keep-private"
SUPER_ADMIN_NAME="Maty Bohacek"

# Where uploaded media is stored on disk.
# On Railway, attach a Volume mounted at /data and leave this as /data.
DATA_DIR="/data"

# Public URL of the deployed app (used for absolute links / Open Graph).
NEXT_PUBLIC_APP_URL="https://slop.matybohacek.com"

# Contact string sent to OpenStreetMap's Nominatim geocoder (their usage
# policy asks for a way to reach you). Your email is fine.
NOMINATIM_CONTACT="you@example.com"
